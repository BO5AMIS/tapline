{
  "name": "tapline-host",
  "version": "1.6.1",
  "description": "Tapline host: lets AI agents see and drive your own React Native / Expo app on a test phone on the same Wi-Fi (MCP server and CLI).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bo5amis/tapline.git",
    "directory": "packages/host"
  },
  "homepage": "https://github.com/bo5amis/tapline/tree/main/packages/host#readme",
  "bugs": {
    "url": "https://github.com/bo5amis/tapline/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "testing",
    "mcp",
    "mcp-server",
    "ai-agent",
    "e2e",
    "ios"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tapline": "dist/bin.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen:viewer": "node scripts/gen-viewer-page.mjs",
    "build": "node scripts/gen-viewer-page.mjs && node scripts/copy-skill.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "gifenc": "1.0.3",
    "jpeg-js": "^0.4.4",
    "qrcode": "^1.5.4",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
